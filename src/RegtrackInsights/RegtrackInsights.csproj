<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The single project for this repo: Program.cs, appsettings, launch profiles, and all
    the code under Insights.*.

    It lives in src\RegtrackInsights\ rather than at the repo root ON PURPOSE, and that
    is load-bearing. The SDK's default globs are rooted at the PROJECT directory and
    exclude only that project's own bin\ and obj\. A project at the repo root therefore
    globs tests\**\bin, copies it into its own output, then globs THAT copy on the next
    build - nesting until paths blow past MAX_PATH and the build dies in MSB3030 before
    the compiler ever runs. Keeping every project a sibling under src\ or tests\ makes
    that impossible by construction, which is why no EnableDefault*Items overrides are
    needed here.

    RULE: never place a project directory above another project directory. If Insights.*
    below are ever promoted to real projects, move them OUT to src\Insights.X\ as
    siblings of this folder - do not leave a csproj nested underneath this one.

    [CHANGED 2026-09-16] Was: "PRIVATE: no public endpoints, no ingress. The Insights API
    endpoints live in the existing RegTrack API, where auth already lives (CLAUDE.md 6)."

    Product decision, same date: the worker and the Insights HTTP API are now ONE deployed
    process/pod, not two - see ADR-0004. This project now also serves HTTP (WebApplication, not
    plain Host - see Program.cs) on top of its existing Durable Task dequeue loop. Insights.Api/
    below is a real, compiled, mapped part of this assembly, gated by JwtAuthRegistration's
    fallback "authenticated by default" policy - it is not the RegTrack API's source drop anymore.
    CLAUDE.md Sec.6 / docs/API_CONTRACTS.md / docs/SOLUTION_STRUCTURE.md describe the SUPERSEDED
    two-host design and should be treated as stale until a docs pass catches up (flagged, not yet
    done as of this change).
  -->

  <PropertyGroup>
    <AssemblyName>RegtrackInsights</AssemblyName>
    <RootNamespace>RegtrackInsights</RootNamespace>
    <UserSecretsId>regtrack-insights-worker</UserSecretsId>
  </PropertyGroup>

  <!--
    Brings in WebApplication/Kestrel/MVC minimal-API types without switching the SDK to
    Microsoft.NET.Sdk.Web - deliberately, because the Web SDK would silently change this project's
    default Content/None globs, and several of them are load-bearing (prompts\**, templates\**,
    the linked-in sql\** tree, and the vendored dompurify/fonts Content blocks below). This is the
    same pattern tests\Insights.UnitTests already uses for the same reason.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.DurableTask.SqlServer" />
    <PackageReference Include="Microsoft.Azure.DurableTask.Core" />
    <PackageReference Include="Microsoft.Azure.KeyVault" />
    <PackageReference Include="Microsoft.IdentityModel.Clients.ActiveDirectory" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <!--
    Trplclientsecret.dll - vendored from the real RegTrack API repo (libs\Trplclientsecret.dll
    there too), same treatment as vendor/dompurify-3.4.14.min.js below: checked in, never fetched
    at runtime. Old .NET Framework 4.0 assembly, but only references mscorlib - confirmed loading
    and calling cleanly under .NET 8 live (2026-08-24) before being wired in here.

    [MUST stay named exactly Trplclientsecret.dll - tried renaming it to Trplclientsecret-uat.dll
    2026-09-15 for clarity (the secret inside is confirmed UAT-only, never production) and that
    broke runtime loading: HintPath only tells the COMPILER where to find the file - the .NET
    runtime probes for a file matching the assembly's own internal name (embedded in the DLL at
    build time, unrelated to whatever this file is named on disk), which is "Trplclientsecret",
    not whatever HintPath points at. Renaming the physical file throws
    FileNotFoundException("Could not load file or assembly 'Trplclientsecret...'") at runtime even
    though the build succeeds fine. Document the UAT-only fact in comments instead of the filename.
  -->
  <ItemGroup>
    <Reference Include="Trplclientsecret">
      <HintPath>..\..\libs\Trplclientsecret.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>


  <!-- Tests reach internals without everything having to be public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Insights.UnitTests" />
    <InternalsVisibleTo Include="Insights.IntegrationTests" />
    <InternalsVisibleTo Include="Insights.GoldenTests" />
  </ItemGroup>

  <!--
    Prompts and email templates ship as CONTENT, not embedded strings.
    Agents:PromptDirectory defaults to ./prompts, Email:TemplatePath to ./templates.
    The None Remove stops the SDK's default None glob claiming them first.
  -->
  <ItemGroup>
    <None Remove="prompts\**\*.md" />
    <None Remove="templates\**\*.*" />
    <Content Include="prompts\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="templates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    SQL is installed with sqlcmd, never compiled or deployed with the host. Linked in
    from the repo root purely so it is visible in Solution Explorer.
  -->
  <ItemGroup>
    <None Include="..\..\sql\**\*.sql" LinkBase="sql" />
  </ItemGroup>

  <!--
    Vendored DOMPurify (see vendor/README - fetched from unpkg, checked in, never fetched at
    runtime). Ships as CONTENT next to the exe so DomPurifySanitizer can load it via
    AppContext.BaseDirectory, same convention as prompts/templates.
  -->
  <ItemGroup>
    <Content Include="..\..\vendor\dompurify-3.4.14.min.js" Link="vendor\dompurify-3.4.14.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Real vendored Poppins glyph data (vendor/README.md "fonts/" entry) - the fix for the
    LLM-authored-@font-face trap: PoppinsFontInjector embeds these as data: URIs post-
    generation, so the render agent never has to (and never can) produce real font bytes
    itself. Same CopyToOutputDirectory/AppContext.BaseDirectory convention as dompurify above.
  -->
  <ItemGroup>
    <Content Include="..\..\vendor\fonts\poppins-400.woff2" Link="vendor\fonts\poppins-400.woff2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vendor\fonts\poppins-500.woff2" Link="vendor\fonts\poppins-500.woff2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vendor\fonts\poppins-600.woff2" Link="vendor\fonts\poppins-600.woff2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    [CHANGED 2026-09-16, ADR-0004] Insights.Api used to be excluded here (Compile Remove) because
    it was source staged for a SEPARATE RegTrack API process to take. That design is superseded:
    this project now compiles and maps these endpoints itself (see Program.cs). Removing the
    exclusion without also removing it is what would have caused CS0436 duplicate-type errors, so
    this change landed together with removing the matching <Compile Include> blocks in
    tests\Insights.UnitTests, tests\Insights.IntegrationTests and tools\Insights.ApiDevHost - all
    three now get these types via their existing ProjectReference to this project instead of
    recompiling the same source a second time.
  -->

</Project>
