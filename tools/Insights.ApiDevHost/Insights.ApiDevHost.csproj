<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    LOCAL DEVELOPER HARNESS. Never deployed.

    [CHANGED 2026-09-16, ADR-0004] The Insights worker and the Insights HTTP API are now ONE
    combined deployed host (RegtrackInsights.csproj), with real JWT validation
    (Insights.Worker.Auth.JwtAuthRegistration) - superseding the two-host design this comment
    originally described. This harness's REASON to keep existing has narrowed: it is still useful
    for hitting these endpoints with Swagger and the X-Insights-UserId header stub instead of a
    real minted token, which is faster for pure routing/SQL/serialisation iteration. It is
    otherwise no longer the only way to click through these endpoints - the real combined host
    does that now, with real auth.

    WHAT IT STILL DOES NOT PROVE: HeaderInsightsCaller is a stub reading a header, not
    authentication - see its own doc comment. The IDOR guard's SHAPE (does the eligibility check
    run, in the right order) is exercised here; that a token was genuinely validated is only
    proven by the real combined host's JwtInsightsCaller path.

    Sibling of src/ and tests/, never nested inside another project directory - see the note in
    RegtrackInsights.csproj about the SDK's default globs and MSB3030.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Insights.ApiDevHost</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RegtrackInsights/RegtrackInsights.csproj" />
  </ItemGroup>

  <!--
    [CHANGED 2026-09-16, ADR-0004] Insights.Api is now compiled by RegtrackInsights.csproj itself
    (see that project's own comment) - the <Compile Include> that used to be here would now
    produce CS0436 duplicate-type errors against the types this project already gets through the
    ProjectReference above.
  -->

</Project>
