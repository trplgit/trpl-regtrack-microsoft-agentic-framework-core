<Project>
  <!--
    Central package management. Versions are pinned HERE, once. A .csproj names the
    package it needs and never carries a Version attribute.

    Versions below are aligned with the existing RegTrack API (RegtrackCompliance.csproj)
    so the two solutions do not disagree on a shared dependency.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Data access - versions matched to the RegTrack API">
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.23" />
  </ItemGroup>
  <ItemGroup Label="Azure - versions matched to the RegTrack API">
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.8.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.23.0" />
    <!-- Test-only: the model-comparison lab (Insights.IntegrationTests) authenticates against
         Foundry via Entra ID (DefaultAzureCredential) instead of an API key, so it never needs to
         hold a secret for the 3 models under test. Not referenced by RegtrackInsights.csproj itself -
         production still uses MafAgentFactory's ApiKeyCredential path.
         [TRAP - found live] Azure.AI.OpenAI's AzureOpenAIClient looked like the obvious fit (it
         takes a TokenCredential directly) but constructs requests against the classic
         /openai/deployments/{name}/... route - confirmed via curl that these Foundry Models
         deployments only support the newer unified /openai/v1/ route (AzureOpenAIClient returned
         404 for a model curl proved works against that route). Removed - the lab instead builds a
         plain OpenAI.OpenAIClient (matching MafAgentFactory's proven endpoint shape exactly) with
         a hand-rolled AuthenticationTokenProvider adapter wrapping DefaultAzureCredential. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="Presentation">
    <PackageVersion Include="HtmlSanitizer" Version="9.0.892" />
  </ItemGroup>
  <ItemGroup Label="Host">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <!-- In-memory HTTP host for the Insights.Api endpoint tests. The IDOR guard is the highest-
         risk logic in this feature, and testing it through real routing and real status codes is
         worth far more than testing the helper it calls. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
    <!-- Swagger UI for tools/Insights.ApiDevHost only - a LOCAL harness, never deployed. The
         worker itself stays private with no ingress (CLAUDE.md 6). -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- In-memory EF Core provider for PersistActivityTests - the GeneratedReport row shape
         without a real UAT connection. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.23" />
  </ItemGroup>
  <!--
    Phase 1d - MAF (Microsoft Agent Framework), current stable per NuGet as of 2026-08-20.
    CLAUDE.md 3.2/7 still document Claude as the real provider; Microsoft.Agents.AI.OpenAI is
    wired for a temporary dev-time swap (GPT-5.2 via Azure AI Foundry), same pattern as the
    free digest's Azure OpenAI swap earlier - not a permanent architecture change.
  -->
  <ItemGroup Label="Agents (MAF) - Phase 1d">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.18.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.18.0" />
    <!-- AsIChatClient(ResponsesClient, ...) lives here - needed explicitly, not left to
         transitive resolution, matching this file's "name the package you need" convention.
         [TRAP] GetResponsesClient()/AsIChatClient(ResponsesClient,...) are marked
         [Experimental("OPENAI001")] in this SDK version - real, verified working (2026-08-20
         smoke test against GPT-5.2 via Azure AI Foundry), but not yet a stable surface. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageVersion Include="OpenAI" Version="2.11.0" />
  </ItemGroup>
  <!--
    Playwright drives a real headless Chromium for two distinct jobs: executing the vendored
    DOMPurify bundle (vendor/dompurify-3.4.14.min.js - fetched and checked in, never fetched at
    runtime) against the normalizer-approved HTML, and cosmetic QA on the result. Current stable
    per NuGet as of 2026-08-20.
  -->
  <ItemGroup Label="Presentation - Playwright (DOMPurify execution + cosmetic QA)">
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
  <!--
    Durable execution (build order item 11) - classic DTFx (DurableTask.Core's TaskHubWorker/
    TaskHubClient), NOT the newer Microsoft.DurableTask.Worker/.Client portable SDK - that SDK
    only supports Azure Durable Task Scheduler as a backend, not self-hosted SQL Server (verified
    2026-08-21, see docs/superpowers/specs/2026-08-21-durable-task-orchestrator-design.md 11).
    Microsoft.Azure.DurableTask.Core version pinned to the exact minimum Microsoft.DurableTask.
    SqlServer 1.8.1 declares, so both are tested against the same baseline.
  -->
  <ItemGroup Label="Durable Task - classic DTFx + SQL Server provider">
    <PackageVersion Include="Microsoft.DurableTask.SqlServer" Version="1.8.1" />
    <PackageVersion Include="Microsoft.Azure.DurableTask.Core" Version="3.9.0" />
  </ItemGroup>
  <!--
    Envelope encryption (build order item 14) - the real DocAI pattern, reused verbatim (design
    doc Sec.9.2). Both deprecated by Microsoft in favour of Azure.Identity/Microsoft.Identity.Client,
    but confirmed working live under .NET 8 (2026-08-24) before being pinned here - not a guess.
    Migrating off ADAL is a natural follow-up, not done here without the team's sign-off first.
  -->
  <ItemGroup Label="Persistence - envelope encryption (build order item 14)">
    <PackageVersion Include="Microsoft.Azure.KeyVault" Version="3.0.5" />
    <PackageVersion Include="Microsoft.IdentityModel.Clients.ActiveDirectory" Version="5.3.0" />
  </ItemGroup>
  <!--
    Observability (build order item 17 / CLAUDE.md 7) - OTel -> LangFuse. IChatClient calls are
    instrumented via Microsoft.Extensions.AI's own OpenTelemetryChatClient (ships inside the
    Microsoft.Extensions.AI package already referenced transitively via Microsoft.Extensions.AI.
    OpenAI - no separate package for that half). These two are the SDK side: collect the spans/
    metrics this process emits and ship them to LangFuse's OTLP endpoint over HTTP.
  -->
  <ItemGroup Label="Observability - OpenTelemetry -> LangFuse (build order item 17)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <!--
    Phase 1d additions, still not pinned:
      The Anthropic MAF provider   (real compose / narrate provider)
  -->
</Project>