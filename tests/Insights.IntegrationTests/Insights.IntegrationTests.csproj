<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs against the fixture database in docs/GOLDEN_FIXTURES.md (tenant 999001). -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RegtrackInsights/RegtrackInsights.csproj" />
  </ItemGroup>

  <!-- Trplclientsecret.dll is a raw file Reference, not a PackageReference, in RegtrackInsights.csproj -
       those do not flow transitively through a ProjectReference, so a manual test that needs it here
       (proving item 14's decrypt path) needs its own reference to the same vendored file.
       MUST stay named exactly Trplclientsecret.dll - see RegtrackInsights.csproj's own comment on
       this same file: renaming it breaks runtime assembly loading (the .NET runtime probes for a
       file matching the assembly's internal name, not the HintPath filename). Confirmed UAT-only
       secret, not production - documented here, not in the filename. -->
  <ItemGroup>
    <Reference Include="Trplclientsecret">
      <HintPath>../../libs/Trplclientsecret.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    Insights.Api is excluded from the worker build on purpose (the worker is private, no ingress).
    Compiling it here lets a manual run host the endpoints on an in-memory server and hit them
    against real UAT data - without giving the worker a port, and without a second host project.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <Compile Include="../../src/RegtrackInsights/Insights.Api/**/*.cs" LinkBase="Insights.Api" />
  </ItemGroup>

</Project>
