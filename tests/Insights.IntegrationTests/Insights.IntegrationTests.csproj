<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs against the fixture database in docs/GOLDEN_FIXTURES.md (tenant 999001). -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RegtrackInsights/RegtrackInsights.csproj" />
  </ItemGroup>

  <!-- Trplclientsecret.dll is a raw file Reference, not a PackageReference, in RegtrackInsights.csproj -
       those do not flow transitively through a ProjectReference, so a manual test that needs it here
       (proving item 14's decrypt path) needs its own reference to the same vendored file.
       MUST stay named exactly Trplclientsecret.dll - see RegtrackInsights.csproj's own comment on
       this same file: renaming it breaks runtime assembly loading (the .NET runtime probes for a
       file matching the assembly's internal name, not the HintPath filename). Confirmed UAT-only
       secret, not production - documented here, not in the filename. -->
  <ItemGroup>
    <Reference Include="Trplclientsecret">
      <HintPath>../../libs/Trplclientsecret.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    [CHANGED 2026-09-16, ADR-0004] Insights.Api used to be excluded from RegtrackInsights.csproj,
    so this project compiled the same source directly to host it on an in-memory server against
    real UAT data. RegtrackInsights.csproj now compiles Insights.Api itself, so the
    <Compile Include> below was removed - keeping it would produce CS0436 duplicate-type errors
    against the types this project already gets through the ProjectReference above.
    FrameworkReference and the TestHost package stay: this project still builds its own
    TestServer directly.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

</Project>
