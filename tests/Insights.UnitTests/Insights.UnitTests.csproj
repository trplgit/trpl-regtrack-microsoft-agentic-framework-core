<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RegtrackInsights/RegtrackInsights.csproj" />
  </ItemGroup>

  <!--
    [CHANGED 2026-09-16, ADR-0004] Insights.Api used to be excluded from RegtrackInsights.csproj,
    so this project compiled the same source directly to keep it type-checked. RegtrackInsights.csproj
    now compiles Insights.Api itself (the worker and the HTTP API are one combined host), so the
    <Compile Include> below was removed - keeping it would produce CS0436 duplicate-type errors
    against the types this project already gets through the ProjectReference below.
    FrameworkReference stays: InsightsApiTestHost.cs still builds a real TestServer/WebApplication
    directly in this project.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
