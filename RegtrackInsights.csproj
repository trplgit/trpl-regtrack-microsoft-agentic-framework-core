<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The single project for this repo: Program.cs, appsettings, launch profiles, and all
    the code under src\Insights.*.

    PRIVATE: no public endpoints, no ingress. The Insights API endpoints live in the
    existing RegTrack API, where auth already lives (CLAUDE.md 6).
  -->

  <PropertyGroup>
    <AssemblyName>RegtrackInsights</AssemblyName>
    <RootNamespace>RegtrackInsights</RootNamespace>
    <UserSecretsId>regtrack-insights-worker</UserSecretsId>

    <!--
      This project sits at the repo root, so the SDK's default glob would sweep in every
      .cs under tests\ (which the test projects already compile) and every generated file
      under obj\. Turn the glob off and list what this project owns, below.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!--
    Program.cs plus everything under src\. Add a new folder under src\ and its .cs files
    compile automatically - nothing to register here.
    appsettings*.json are picked up and copied by the SDK's default Content items.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="HtmlSanitizer" />
  </ItemGroup>

  <!-- Tests reach internals without everything having to be public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Insights.UnitTests" />
    <InternalsVisibleTo Include="Insights.IntegrationTests" />
    <InternalsVisibleTo Include="Insights.GoldenTests" />
  </ItemGroup>

  <!--
    Prompts and email templates ship as CONTENT, not embedded strings.
    Agents:PromptDirectory defaults to ./prompts, Email:TemplatePath to ./templates.
  -->
  <ItemGroup>
    <Content Include="prompts\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="templates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SQL is installed with sqlcmd, never compiled or deployed with the host. -->
  <ItemGroup>
    <None Include="sql\**\*.sql" />
  </ItemGroup>

</Project>
